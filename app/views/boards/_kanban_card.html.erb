<% checklist_done = card.checklist_items.count(&:done) %>
<% dormant = card.dormant? %>
<article id="<%= dom_id card %>" data-card-id="<%= card.id %>" data-move-url="<%= move_card_path(card) %>"
         class="group relative bg-white rounded-xl border shadow-sm p-3.5 cursor-grab active:cursor-grabbing transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 <%= card.escalated? ? "border-rose-200 border-l-4 border-l-rose-500" : "border-gray-100" %> <%= "ring-2 ring-violet-300" if card == @card %> <%= "opacity-60 grayscale hover:opacity-100 hover:grayscale-0" if dormant %>"
         <% if dormant %>title="<%= card.dormant_days %> gündür dokunulmadı — taşı veya düzenle, kart uyansın"<% end %>>
  <%= link_to card.title, card_path(card), draggable: false, class: "absolute inset-0 rounded-xl text-transparent", "aria-label": "#{card.title} kartını aç" %>

  <% if card.labels.any? %>
    <div class="mb-2 flex flex-wrap gap-1">
      <% card.labels.each do |label| %>
        <span class="<%= label_tone(label) %> h-2 w-10 rounded-full" title="<%= label.name %>"></span>
      <% end %>
    </div>
  <% end %>

  <div class="flex items-start justify-between gap-2">
    <h3 class="font-semibold text-sm leading-snug <%= card.completed? ? "text-slate-400 line-through" : "text-slate-800" %>"><%= card.title %></h3>
    <% if card.escalated? %>
      <span class="shrink-0 rounded-full bg-orange-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-orange-600">SLA</span>
    <% elsif card.completed? %>
      <svg class="size-4 shrink-0 text-emerald-500" viewBox="0 0 20 20" fill="currentColor" aria-label="Tamamlandı">
        <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.86-9.86a.75.75 0 0 0-1.22-.88l-3.24 4.5-1.8-1.8a.75.75 0 1 0-1.06 1.06l2.42 2.42a.75.75 0 0 0 1.14-.09l3.76-5.21Z" clip-rule="evenodd" />
      </svg>
    <% end %>
  </div>

  <% if card.due_date.present? || card.description.present? || card.checklist_items.any? || card.members.any? %>
    <div class="mt-3 flex items-center justify-between gap-2">
      <div class="flex flex-wrap items-center gap-1.5">
        <% if card.due_date.present? %>
          <span class="inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs font-medium <%= card.overdue? ? "bg-red-50 text-red-500 ring-1 ring-red-100" : "bg-slate-100 text-slate-500" %>">
            <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.75 2a.75.75 0 0 1 .75.75V4h7V2.75a.75.75 0 0 1 1.5 0V4h.25A2.75 2.75 0 0 1 18 6.75v8.5A2.75 2.75 0 0 1 15.25 18H4.75A2.75 2.75 0 0 1 2 15.25v-8.5A2.75 2.75 0 0 1 4.75 4H5V2.75A.75.75 0 0 1 5.75 2Zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75Z" clip-rule="evenodd" />
            </svg>
            <time datetime="<%= card.due_date.to_date.iso8601 %>"><%= card.due_date.strftime("%d.%m.%Y") %></time>
          </span>
        <% end %>
        <% if card.description.present? %>
          <svg class="size-4 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-label="Açıklama var">
            <path fill-rule="evenodd" d="M2 4.75A.75.75 0 0 1 2.75 4h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 4.75Zm0 5A.75.75 0 0 1 2.75 9h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 9.75Zm0 5a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 0 1.5h-8.5a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
          </svg>
        <% end %>
        <% if card.checklist_items.any? %>
          <% all_done = checklist_done == card.checklist_items.size %>
          <span class="inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-xs font-medium <%= all_done ? "bg-emerald-100 text-emerald-700" : "text-slate-500" %>">
            <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.7 4.15a.75.75 0 0 1 .15 1.05l-8 10.5a.75.75 0 0 1-1.13.08l-4.5-4.5a.75.75 0 1 1 1.06-1.06l3.9 3.9 7.47-9.8a.75.75 0 0 1 1.05-.15Z" clip-rule="evenodd" />
            </svg>
            <%= checklist_done %>/<%= card.checklist_items.size %>
          </span>
        <% end %>
      </div>

      <% if card.members.any? %>
        <div class="flex -space-x-1.5">
          <% card.members.each do |member| %>
            <%= member_avatar(member, size: "size-6") %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if dormant %>
    <div class="mt-2.5 flex justify-end">
      <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-400 ring-1 ring-slate-200/70 transition-colors group-hover:bg-indigo-50 group-hover:text-indigo-500 group-hover:ring-indigo-100">
        <span class="font-bold tracking-tighter italic" aria-hidden="true">z<sup>z</sup><sup class="text-[8px]">z</sup></span>
        Uyuyan kart · <%= card.dormant_days %> gün
      </span>
    </div>
  <% end %>
</article>
