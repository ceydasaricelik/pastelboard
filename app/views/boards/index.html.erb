<% content_for :title, "Panolar" %>
<% content_for :full_width, true %>

<div class="max-w-6xl mx-auto min-h-screen px-5 py-10">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-600 font-medium rounded-xl inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-8">
    <div>
      <p class="text-sm font-medium text-teal-600 mb-1">PastelBoard</p>
      <h1 class="font-bold text-4xl text-slate-800">Panolar</h1>
    </div>
    <%= link_to "Yeni pano", new_board_path, class: "rounded-xl px-4 py-2.5 bg-teal-500 hover:bg-teal-400 text-white font-medium shadow-sm" %>
  </div>

  <div id="boards" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <% if @boards.any? %>
      <% @boards.each_with_index do |board, index| %>
        <% tones = [
          "bg-blue-50 border-blue-100 hover:border-blue-200",
          "bg-teal-50 border-teal-100 hover:border-teal-200",
          "bg-rose-50 border-rose-100 hover:border-rose-200",
          "bg-amber-50 border-amber-100 hover:border-amber-200"
        ] %>
        <%= link_to board, class: "block rounded-2xl border #{tones[index % tones.length]} p-6 shadow-sm transition hover:shadow-md" do %>
          <h2 class="text-xl font-semibold text-slate-800 mb-2"><%= board.name %></h2>
          <p class="text-slate-500 text-sm leading-relaxed"><%= board.description.presence || "Açıklama yok" %></p>
          <p class="mt-4 text-xs font-medium text-slate-400"><%= board.lists.count %> liste</p>
        <% end %>
      <% end %>
    <% else %>
      <p class="text-center my-10 text-slate-500 col-span-full">Henüz pano yok.</p>
    <% end %>
  </div>
</div>
