<% content_for :title, @card ? "#{@card.title} · #{@board.name}" : @board.name %>
<% content_for :full_width, true %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>

<div class="h-screen flex flex-col bg-slate-100 overflow-hidden">
  <header class="flex-none flex flex-wrap items-end justify-between gap-4 px-6 pt-6 pb-5">
    <div>
      <div class="flex items-center gap-3 text-sm font-medium">
        <span class="flex items-center gap-1.5 font-bold text-slate-700">
          <%= image_tag "/icon.svg", alt: "", class: "size-5" %> PastelBoard
        </span>
        <span class="text-slate-300">/</span>
        <%= link_to "← Panolar", boards_path, class: "text-violet-500 hover:text-violet-400" %>
      </div>
      <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-800"><%= @board.name %></h1>
      <% if @board.description.present? %>
        <p class="mt-1 text-slate-500"><%= @board.description %></p>
      <% end %>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <span id="agent_mode" class="rounded-full bg-white px-3 py-1.5 text-xs font-semibold shadow-sm ring-1 ring-slate-200 <%= AgentBoards::LlmFactory.simulated? ? "text-amber-600" : "text-emerald-600" %>">
        <%= agent_mode_label(@board) %>
      </span>
      <%= button_to board_round_path(@board), id: "run_round", data: { turbo_submits_with: "Ajanlar çalışıyor…" },
            class: "cursor-pointer rounded-xl bg-violet-500 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-400 disabled:cursor-wait disabled:opacity-60" do %>
        ▶ Bir tur çalıştır
      <% end %>
      <% if demo_time_travel? %>
        <%= button_to "Demo panoyu sıfırla", agent_demo_path,
              form: { data: { turbo_confirm: "Demo ajan panosu silinip yeniden kurulsun mu?" } },
              class: "cursor-pointer rounded-xl bg-white px-3 py-2 text-sm font-semibold text-slate-500 shadow-sm ring-1 ring-slate-200 hover:text-slate-800" %>
      <% end %>
    </div>

    <% if notice.present? || alert.present? %>
      <div class="basis-full">
        <% if notice.present? %>
          <p id="notice" class="inline-block rounded-xl bg-emerald-50 px-3 py-2 text-sm font-medium text-emerald-600"><%= notice %></p>
        <% end %>
        <% if alert.present? %>
          <p id="alert" class="inline-block rounded-xl bg-red-50 px-3 py-2 text-sm font-medium text-red-500"><%= alert %></p>
        <% end %>
      </div>
    <% end %>
  </header>

  <div class="flex-1 min-h-0 flex flex-nowrap overflow-x-auto gap-4 px-6 pb-6">
    <%= render partial: "agent_boards/column", collection: @lists, as: :list, locals: { board: @board } %>
    <%= render "agent_boards/sidebar", board: @board %>
  </div>
</div>

<%= render "agent_boards/detail", card: @card, board: @board if @card %>
