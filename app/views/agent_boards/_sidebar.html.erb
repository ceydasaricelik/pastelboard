<aside id="agents" class="min-w-[300px] max-w-[300px] w-[300px] flex-none self-start space-y-4">
  <section id="guidelines" class="rounded-2xl bg-white/70 p-4 shadow-sm ring-1 ring-slate-200">
    <h2 class="text-sm font-semibold text-slate-700">Ekip rehberi</h2>
    <p class="text-xs text-slate-400">Mentorun bildiği ekip kuralları. İşçiler görmez.</p>
    <% rules = guideline_lines(board) %>
    <% if rules.any? %>
      <ul class="mt-2 list-disc space-y-1 pl-4 text-sm text-slate-600">
        <% rules.each do |rule| %>
          <li><%= rule %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-sm text-slate-400">Bu panonun ekip rehberi yok.</p>
    <% end %>
  </section>

  <section class="rounded-2xl bg-white/70 p-4 shadow-sm ring-1 ring-slate-200">
    <h2 class="text-sm font-semibold text-slate-700">Ajanlar</h2>
    <div class="mt-3 space-y-4">
      <% board.members.each do |member| %>
        <div id="<%= dom_id member %>">
          <div class="flex items-center gap-2">
            <%= member_avatar(member, size: "size-8") %>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-slate-700"><%= member.name %> <span class="font-normal text-slate-400">· <%= agent_role_label(member) %></span></p>
              <p class="truncate font-mono text-[11px] text-slate-400"><%= member.model %></p>
            </div>
          </div>
          <% lessons = lesson_lines(member) %>
          <p class="mt-2 text-[11px] font-semibold uppercase tracking-wide text-slate-400">Ders defteri</p>
          <% if lessons.any? %>
            <ul class="mt-1 list-disc space-y-1 pl-4 text-xs text-slate-600">
              <% lessons.each do |lesson| %>
                <li><%= lesson %></li>
              <% end %>
            </ul>
          <% else %>
            <p class="mt-1 text-xs text-slate-400">Henüz ders yok.</p>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
</aside>
