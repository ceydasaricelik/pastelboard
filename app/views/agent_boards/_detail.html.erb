<% review = latest_review_event(card) %>
<% criteria = review_criteria(card) %>
<% violations = Array(review&.data&.dig("guideline_violations")) %>
<% question = agent_question(card) %>
<% hint = human_hint(card) %>
<% feedback = mentor_feedback(card) %>
<div id="card_detail" class="fixed inset-0 z-40 flex items-start justify-center overflow-y-auto p-4 sm:p-10">
  <%= link_to "", board_path(board), class: "fixed inset-0 bg-slate-900/30 backdrop-blur-[1px]", "aria-label": "Kartı kapat" %>

  <div class="relative w-full max-w-2xl rounded-2xl bg-white shadow-xl ring-1 ring-gray-100">
    <div class="flex items-start justify-between gap-4 border-b border-gray-100 px-6 py-4">
      <div>
        <p class="text-xs font-medium text-slate-400"><%= card.list.name %> listesinde</p>
        <div class="mt-1 flex flex-wrap items-center gap-2">
          <%= agent_state_badge(card) %>
          <% if card.attempts > 0 %>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-500">Deneme <%= card.attempts %>/<%= AgentBoards::Tick::MAX_ATTEMPTS %></span>
          <% end %>
          <% if card.assignee %>
            <span class="flex items-center gap-1.5 text-xs font-medium text-slate-500">
              <%= member_avatar(card.assignee, size: "size-5") %> <%= card.assignee.name %> · <%= agent_role_label(card.assignee) %>
            </span>
          <% end %>
        </div>
      </div>
      <%= link_to "✕", board_path(board), class: "rounded-lg px-2 py-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700", "aria-label": "Kapat" %>
    </div>

    <div class="space-y-5 px-6 py-5">
      <div>
        <h2 class="text-xl font-semibold text-slate-800"><%= card.title %></h2>
        <% if card.description.present? %>
          <p class="mt-1 whitespace-pre-line text-sm text-slate-600"><%= card.description %></p>
        <% end %>
      </div>

      <% if card.agent_needs_human? %>
        <div id="human_actions" class="space-y-3 rounded-xl bg-rose-50 p-4 ring-1 ring-rose-200">
          <p class="text-sm font-semibold text-rose-700">
            <%= question ? "Ajan insana soru sordu" : "Bu kart insana devredildi" %>
          </p>
          <% if question %>
            <div id="agent_question">
              <p class="text-xs font-semibold uppercase tracking-wide text-rose-400">Ajanın sorusu</p>
              <p class="whitespace-pre-line text-sm text-rose-800"><%= question %></p>
            </div>
          <% end %>
          <%= form_with url: card_hint_path(card), class: "space-y-2" do |form| %>
            <%= form.text_area :hint, rows: 3, required: true, placeholder: "İpucu yaz (ör. ürün adı, özellikler, fiyat)…",
                  class: "w-full rounded-lg border border-rose-200 bg-white px-3 py-2 text-sm text-slate-700 placeholder:text-slate-400 outline-none focus:border-rose-300 focus:ring-2 focus:ring-rose-100" %>
            <%= form.submit "İpucu ver ve geri gönder", class: "cursor-pointer rounded-lg bg-violet-500 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-400" %>
          <% end %>
          <%= button_to "Onayla, Done'a taşı", card_approval_path(card),
                class: "cursor-pointer rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-400" %>
        </div>
      <% end %>

      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">Kabul kriterleri</p>
        <ul class="space-y-1.5">
          <% card.checklist_items.each do |item| %>
            <% result = criteria[item.id] %>
            <li class="flex items-start gap-2 text-sm">
              <% if result.nil? %>
                <span class="mt-0.5 w-4 text-center text-slate-300" aria-label="Henüz incelenmedi">•</span>
              <% elsif result["met"] %>
                <span class="mt-0.5 w-4 text-center font-bold text-emerald-500" aria-label="Karşılandı">✓</span>
              <% else %>
                <span class="mt-0.5 w-4 text-center font-bold text-rose-500" aria-label="Karşılanmadı">✗</span>
              <% end %>
              <div>
                <p class="<%= result && !result["met"] ? "text-slate-800" : "text-slate-600" %>"><%= item.content %></p>
                <% if result && result["reason"].present? %>
                  <p class="text-xs text-slate-400"><%= result["reason"] %></p>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </div>

      <% if card.output.present? %>
        <div>
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">İşçinin son çıktısı</p>
          <pre id="card_output" class="whitespace-pre-wrap rounded-xl bg-slate-50 p-3 font-sans text-sm text-slate-700 ring-1 ring-slate-200"><%= card.output %></pre>
        </div>
      <% end %>

      <% if violations.any? %>
        <div id="guideline_violations" class="rounded-xl bg-rose-50 p-4 ring-1 ring-rose-200">
          <p class="text-sm font-semibold text-rose-700">Ekip rehberi ihlali</p>
          <ul class="mt-1 list-disc space-y-0.5 pl-5 text-sm text-rose-800">
            <% violations.each do |violation| %>
              <li><%= violation %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if feedback %>
        <div id="mentor_feedback">
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">Mentor geri bildirimi</p>
          <p class="whitespace-pre-line rounded-xl bg-violet-50 p-3 text-sm text-violet-900 ring-1 ring-violet-100"><%= feedback %></p>
        </div>
      <% end %>

      <% if hint %>
        <div id="human_hint">
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">İnsan ipucu</p>
          <p class="whitespace-pre-line rounded-xl bg-amber-50 p-3 text-sm text-amber-900 ring-1 ring-amber-100"><%= hint %></p>
        </div>
      <% end %>

      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">Zaman çizelgesi</p>
        <ol id="timeline" class="space-y-2">
          <% card.agent_events.each do |event| %>
            <li class="flex items-start gap-3 text-sm">
              <time datetime="<%= event.created_at.iso8601 %>" class="w-24 shrink-0 pt-0.5 text-xs text-slate-400">
                <%= event.created_at.in_time_zone("Istanbul").strftime("%d.%m %H:%M:%S") %>
              </time>
              <div>
                <span class="<%= agent_event_tone(event) %> mr-1 inline-block rounded-full px-2 py-0.5 text-[11px] font-semibold"><%= agent_event_actor(event) %></span>
                <span class="<%= event.kind == "llm_error" ? "text-rose-700" : "text-slate-600" %>"><%= event.message %></span>
              </div>
            </li>
          <% end %>
        </ol>
      </div>
    </div>
  </div>
</div>
